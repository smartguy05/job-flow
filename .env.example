# JobFlow configuration. Copy to .env and fill in. See docs/operations/configuration.md.

# --- Database (Compose creates the postgres service with these) ---
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobflow
# Used by `npm run dev`; Compose builds its own DATABASE_URL from the vars above.
DATABASE_URL=postgres://jobflow:change-me@localhost:5432/jobflow

# --- Public URL (drives OIDC redirects, calendar feed and the MCP resource URL) ---
APP_BASE_URL=https://jobs.example.com

# --- Auth: Authentik OIDC (see docs/auth/authentik-setup.md) ---
OIDC_ISSUER=https://auth.example.com/application/o/jobflow/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# >= 32 chars: openssl rand -base64 48
SESSION_SECRET=

# --- MCP server (optional; see docs/features/mcp.md) ---
# Required `aud` of Claude's access tokens. Defaults to OIDC_CLIENT_ID (Authentik sets aud to
# the issuing provider's client ID). Set when a dedicated "JobFlow MCP" provider issues them.
MCP_OAUTH_AUDIENCE=
# Issuer of that dedicated provider, e.g. https://auth.example.com/application/o/jobflow-mcp/
# Defaults to OIDC_ISSUER.
MCP_OAUTH_ISSUER=

# --- LLM provider keys (operator-wide; at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Reminder cron shared secret (optional) ---
CRON_SECRET=
